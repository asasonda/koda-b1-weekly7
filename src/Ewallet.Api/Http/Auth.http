@baseUrl = http://localhost:5256

### Register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "username": "andiii",
    "fullname": "Andika W",
    "email": "andika@gmail.com",
    "password": "Andika123@@",
    "phoneNumber": "081345671221"
}

### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
    "email": "andika@gmail.com",
    "password": "Andika123@@"
}


### Login customer
# @name loginCustomer
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
    "email": "zakky@gmail.com",
    "password": "Seed@12345"
}

### Login admin
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
    "email": "Andika@gmail.com",
    "password": "Andika123@@"
}

### get wallet CUSTOMER
GET {{baseUrl}}/api/dashboard
Accept: application/json
Authorization: Bearer {{loginCustomer.response.body.accessToken}}

### get user dashboard admin
GET {{baseUrl}}/api/admin/dashboard
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Accept: application/json